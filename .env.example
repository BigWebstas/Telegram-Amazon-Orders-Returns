# Amazon account being polled
AMAZON_EMAIL=you@example.com
AMAZON_PASSWORD=change-me

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your personal Telegram chat id (only this chat is served)
# Get it by messaging @userinfobot
TELEGRAM_CHAT_ID=123456789

# How often to poll Amazon, in minutes
POLL_INTERVAL_MINUTES=30

# How many days of transaction history to re-check on each poll. Keep this
# small - the amazon-orders library defaults to a full year, which would
# treat any transaction the bot hasn't seen yet as brand new. 14 days gives
# enough grace to recover from a stretch of downtime (expired session,
# Telegram outage) without re-pulling most of a year of purchase history.
TRANSACTION_LOOKBACK_DAYS=14

# Directory (inside the container) for the sqlite db and amazon-orders session/cookies
DATA_DIR=/data

# Optional: publish active-orders/returns-in-progress/recent-deliveries counts
# to Home Assistant via MQTT Discovery. Leave MQTT_HOST blank to disable -
# nothing else here matters if it's unset.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=amazon_orders_returns
# Retain published sensor values so HA has them immediately on restart.
# Discovery configs and the availability topic are always retained
# regardless of this setting.
MQTT_RETAIN=true
